# The local telemetry stack, always on: OpenObserve (UI/API on 127.0.0.1:5080,
# gRPC on 5081, data in ~/.local/state/openobserve) and the OpenTelemetry
# collector in front of it (OTLP/HTTP on 127.0.0.1:4318, health on 13133,
# exporting to OpenObserve and to a rotating ~/.local/state/otelcol/*.jsonl),
# as home-manager user services, so every app's
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 finds a stack without a
# `devenv up` and the stack outlives any dev shell.
#
# One source of truth: devenv-fleet's telemetry module (telemetry/devenv.nix).
# It is evaluated here as a module, and the units run its own process and task
# scripts, with the packages from devenv-fleet's pinned nixpkgs (pins.json), so
# the service and a dev shell's `devenv up` run the same store paths on the same
# data dir. A dev shell's `devenv up` probes the ports and attaches to these
# units instead of starting a second stack (and these units idle the same way
# if a dev shell's stack already holds the ports).
#
# The collector keeps that module's sampling as it is: errors, traces of 5 ms
# or more, and spans marked `keep = true`; quick clean traces are dropped.
# Changing that is a devenv-fleet change, for both stacks at once.
#
# OpenObserve's root login is ~/.config/openobserve/credentials.json (mode 600),
# generated by the module's task if missing and read at each start: never in the
# store, never in git.
#
#   Linux:  home-manager user services; included by cody@THEBATTLESHIP.
{
  inputs,
  lib,
  ...
}:
{
  flake-file.inputs = {
    devenv-fleet = {
      # feat/openobserve: the telemetry module with OpenObserve (Teley opt-in).
      url = lib.mkDefault "github:FastTrackStudios/devenv-fleet/1db17ab179518fc418c385d2a72fa886116c59c4";
      # Only its modules and pkgs/ are used; the pins flake would add a second nixpkgs lock.
      flake = false;
    };
    # devenv-fleet's pins.json nixpkgs: the one every fleet dev shell (and so the
    # `devenv up` stack) builds OpenObserve and otelcol-contrib from. Keep in step.
    devenv-fleet-nixpkgs.url = lib.mkDefault "github:NixOS/nixpkgs/8ce4ef6cb6f871616146b9fe26d2a5ae594e94fe";
  };

  fleet.coding._.cli._.telemetry = {
    description = "OpenObserve (:5080) and the OTLP collector (:4318) as always-on user services (Linux home-manager), from devenv-fleet's telemetry module";

    homeManager =
      { pkgs, ... }:
      lib.mkIf pkgs.stdenv.hostPlatform.isLinux (
        let
          pinned = import inputs.devenv-fleet-nixpkgs { inherit (pkgs.stdenv.hostPlatform) system; };

          # devenv-fleet/telemetry evaluated on its own: only `processes` and
          # `tasks` (devenv's options it sets) are stubbed.
          telemetry =
            (lib.evalModules {
              modules = [
                "${inputs.devenv-fleet}/telemetry/devenv.nix"
                {
                  options.processes = lib.mkOption { type = lib.types.attrsOf lib.types.anything; };
                  options.tasks = lib.mkOption { type = lib.types.attrsOf lib.types.anything; };
                }
              ];
              specialArgs.pkgs = pinned;
            }).config;

          # The module's scripts run in devenv's shell; give them its basics.
          script =
            name: text:
            pkgs.writeShellScript name ''
              export PATH=${
                lib.makeBinPath (
                  with pinned;
                  [
                    coreutils
                    gnused
                    gnugrep
                  ]
                )
              }:$PATH
              ${text}
            '';

          common = {
            Restart = "on-failure";
            RestartSec = 5;
          };
        in
        {
          systemd.user.services.openobserve = {
            Unit.Description = "OpenObserve on 127.0.0.1:${toString telemetry.fleet.telemetry.openobserve.port} (devenv-fleet telemetry)";
            Service = common // {
              ExecStartPre =
                script "openobserve-credentials"
                  telemetry.tasks."fleet:openobserve-credentials".exec;
              ExecStart = script "openobserve" telemetry.processes.openobserve.exec;
            };
            Install.WantedBy = [ "default.target" ];
          };

          systemd.user.services.otel-collector = {
            Unit = {
              Description = "OpenTelemetry collector on 127.0.0.1:${toString telemetry.fleet.telemetry.otlpPort}, exporting to OpenObserve (devenv-fleet telemetry)";
              After = [ "openobserve.service" ];
              Wants = [ "openobserve.service" ];
            };
            Service = common // {
              # The module writes its rendered config (with the login in it) under
              # $DEVENV_STATE/otelcol, mode 600.
              Environment = [ "DEVENV_STATE=%S/otel-collector" ];
              ExecStart = script "otel-collector" telemetry.processes.otelcol.exec;
            };
            Install.WantedBy = [ "default.target" ];
          };
        }
      );
  };
}
