// Loft's early fragment (display overrides from its Settings app);
// first, so this config's own outputs/input win where both set something.
include optional=true "~/.config/loft/niri-early.kdl"
include "outputs.kdl"
include "workspaces.kdl"
include "rules.kdl"
include "startup.kdl"
include "input.kdl"
include "layout.kdl"
include "binds.kdl"
// include "debug.kdl"
include "environment.kdl"
// Loft's fragment (the shell, its keybinds + active theme), written by its
// home-manager module. Last, so Loft's keybinds/theme win.
include optional=true "~/.config/loft/niri.kdl"
