workspace "main" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "code" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "music" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

// Music across all three displays: the arrangement in the middle (music),
// a panel either side — Studio's mixer on the right, say.
workspace "music-left" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "music-right" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "gaming" {
    open-on-output "Microstep MPG491CX OLED Unknown"

    // No focus ring / border / top strut on this workspace so the game fills
    // the screen cleanly. Floating windows still work — they
    // just lose the outline too.
    layout {
        struts {
            top 0
        }
        focus-ring {
            off
        }
        border {
            off
        }
    }
}

// Dedicated Moonlight/Sunshine game-streaming workspace on the right landscape monitor,
// so a stream runs on its own display without touching the main monitors.
workspace "stream" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "recording" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "setup" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "comms" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "media" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "notes" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "research" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

// Test sessions (nested niri windows from Loft dev / agents) land here,
// on the left portrait monitor, unfocused — never on the working workspaces.
workspace "lab" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}
