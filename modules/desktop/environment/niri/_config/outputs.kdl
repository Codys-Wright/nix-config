// Outputs are keyed by monitor make/model/serial — NOT connector (DP-x) —
// because the connector numbers renumber across reboots/replugs and silently
// break every per-output + per-workspace assignment. Identity is stable.
//
//   "Acer Technologies XV271U M3 1321033793LAJ" = left portrait Acer
//   "Acer Technologies XV271U M3 13210337C3LAJ" = right landscape Acer
//   "Microstep MPG491CX OLED Unknown"           = center OLED ultrawide

output "HDMI-A-2" {
    // AOC Q32G1WG4 32" 1440p - far left of everything
    mode "2560x1440@143.912"
    position x=-2560 y=0

    layout {
        default-column-width { proportion 1.0; }
    }
}

output "Acer Technologies XV271U M3 1321033793LAJ" {
    // Acer XV271U M3 - left portrait
    mode "2560x1440@179.999"
    transform "90"
    position x=0 y=0

    layout {
        default-column-width { proportion 1.0; }
    }
}

output "Microstep MPG491CX OLED Unknown" {
    // MSI MPG491CX OLED ultrawide - center
    // VRR disabled: causes flickering on this panel.
    mode "5120x1440@240.000"
    position x=1440 y=0
    focus-at-startup

    layout {
        center-focused-column "on-overflow"

        preset-column-widths {
            proportion 0.25
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
            proportion 0.75
            proportion 1.0
        }

        default-column-width { proportion 0.5; }
    }
}

output "Acer Technologies XV271U M3 13210337C3LAJ" {
    // Acer XV271U M3 - right landscape
    mode "2560x1440@179.999"
    position x=6560 y=0

    layout {
        default-column-width { proportion 1.0; }
    }
}
