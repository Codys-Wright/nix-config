// Translucent windows (Loft's window glass): by default niri paints the focus
// ring / border as a solid rectangle *behind* the window, so a see-through
// focused window showed the ring color instead of the blurred wallpaper.
window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="^kitty$" is-focused=false
    opacity 0.9
}

layer-rule {
    match namespace="^noctalia-overview.*"
    place-within-backdrop true
}

// Broad REAPER catch-all — every REAPER toplevel (main, Mixer, MIDI take,
// FX windows, plugin floats, and any title we haven't enumerated) lands
// on the music workspace. Specific titles below add layout overrides.
window-rule {
    match app-id="^REAPER$"
    open-on-workspace "music"
    open-focused true
}

window-rule {
    match app-id="^REAPER$" title="REAPER v"
    open-maximized true
}

window-rule {
    match app-id="^REAPER$" title="^Mixer$"
    open-maximized true
}

window-rule {
    match app-id="^REAPER$" title="^MIDI take:"
    open-maximized true
}

// ReaScript debug console: floating, must not steal focus from the main
// REAPER window when it pops up.
window-rule {
    match app-id="^REAPER$" title="^ReaScript console output"
    open-focused false
    open-floating true
    default-floating-position x=16 y=16 relative-to="top-right"
}

// xwayland-satellite child surfaces spawned by REAPER (WebKit
// WebProcess, plugin GUIs, etc.) become independent Wayland surfaces
// with synthesized app-ids distinct from "REAPER". Pin anything that
// looks like one onto the music workspace so it never grabs focus on a
// different workspace, and `open-focused false` so REAPER's main window
// stays the active window when the child opens.
//
// We don't yet know the exact app-id pattern xwayland-satellite uses —
// confirm with `niri msg windows` while a desktop-renderer panel is
// open and tighten this match accordingly.
window-rule {
    match app-id="^xwayland-satellite"
    match app-id="^WebKitWebProcess"
    match title="^FTS Demo Desktop"
    match title="^FTS UI Desktop"
    open-on-workspace "music"
    open-focused false
}

window-rule {
    match app-id="^equibop$"
    match app-id="^vesktop$"
    open-on-workspace "comms"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="^zoom$"
    open-on-workspace "comms"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="^Slack$"
    open-on-workspace "comms"
    open-focused true
    open-maximized true
}

// Task: the dev desktop app (`dx serve` names it task-app-desktop-<hash>,
// a new hash per build) and the installed one.
window-rule {
    match app-id="^task-app-desktop"
    match app-id="^task$"
    open-on-workspace "notes"
    open-focused true
}

// FastTrackStudio Studio (app id `studio`) and Session (`session`), dev
// builds under `dx serve` and the installed app alike.
window-rule {
    match app-id="^studio$"
    match app-id="^session$"
    match app-id=r#"^app\.fasttrackstudio\.studio$"#
    open-on-workspace "music"
    open-focused true
}

window-rule {
    match app-id="^obsidian$"
    open-on-workspace "notes"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="^steam$"
    match app-id="^steam_app_.*$"
    open-on-workspace "gaming"
    open-focused true
    open-maximized true
}

// Sunshine streaming surface -> the "stream" workspace on HDMI-A-1 (the AOC),
// so game-streaming runs on its own display and games launched from Big
// Picture stay there instead of escaping to the main "gaming" workspace.
// Placed AFTER the generic steam rule so it overrides that placement.
//
// Primary path: the Sunshine "Steam Big Picture" app runs Big Picture inside
// gamescope, so Big Picture + every game launched from it share one surface
// (app-id "gamescope"). Open it fullscreen so the top bar is covered.
window-rule {
    match app-id="^gamescope$"
    open-on-workspace "stream"
    open-fullscreen true
    open-focused true
}

// Fallback: Big Picture launched directly (not via gamescope). Window
// identity confirmed via `niri msg windows`: app-id "steam", title
// "Steam Big Picture Mode".
window-rule {
    match app-id="^steam$" title="^Steam Big Picture Mode$"
    open-on-workspace "stream"
    open-fullscreen true
    open-focused true
}

window-rule {
    match app-id="^com\\.obsproject\\.Studio$"
    match app-id="^obs$"
    match app-id="^obs-studio$"
    open-on-workspace "recording"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="^opendeck$"
    open-on-workspace "setup"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="^code$"
    match app-id="^codium$"
    match app-id="^Code$"
    match app-id="^VSCodium$"
    match app-id="^dev\\.zed\\.Zed$"
    open-on-workspace "code"
    open-focused true
}

window-rule {
    match app-id="^com\\.nextcloud\\.desktopclient\\.nextcloud$"
    open-on-workspace "main"
    open-focused false
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^org\\.gnome\\.Nautilus$"
    match app-id="^thunar$"
    match app-id="^org\\.kde\\.dolphin$"
    open-on-workspace "main"
    open-focused true
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^mpv$"
    match app-id="^vlc$"
    open-on-workspace "media"
    open-focused true
    open-maximized true
}

// Nested niri sessions (Loft test windows) → the "lab" workspace,
// without stealing focus.
window-rule {
    match app-id="^niri$"
    open-on-workspace "lab"
    open-focused false
}

// Settings, preferences and dialog-type windows open floating (centered) instead
// of as a new column that shoves the workspace around. niri already floats
// dialogs that have a parent; these catch the rest: by title (any app's
// Preferences / Settings / Properties / About / file pickers / confirmations) and
// whole utility apps. Per app: Loft → Settings → Window Rules → Open floating.
window-rule {
    match title="(?i)^(preferences|settings|properties|about|options|configure)\\b"
    match title="(?i)\\b(preferences|settings|properties|options)$"
    match title="(?i)^about "
    match title="(?i)^(open|save|save as|select|choose|export|import)( (file|files|folder|image|location)s?)?…?$"
    match title="(?i)^(rename|delete|replace|confirm|authentication required|unlock)\\b"
    match title="(?i)— (preferences|settings|properties|configure)"
    match title="(?i)(properties|settings) — "
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    match app-id="^pavucontrol$"
    match app-id="^com\\.saivert\\.pwvucontrol$"
    match app-id="^blueman-manager"
    match app-id="^\\.blueman-manager-wrapped$"
    match app-id="^nm-connection-editor$"
    match app-id="^org\\.gnome\\.Settings$"
    match app-id="^org\\.gnome\\.FileRoller$"
    match app-id="^xdg-desktop-portal"
    match app-id="^org\\.freedesktop\\.impl\\.portal"
    match app-id="^polkit"
    match app-id="^org\\.kde\\.polkit"
    match app-id="^org\\.kde\\.kdialog$"
    match app-id="^zenity$"
    match app-id="^org\\.gnome\\.Calculator$"
    match app-id="^qalculate"
    match app-id="^nwg-look$"
    match app-id="^qt[56]ct$"
    match app-id="^kvantummanager$"
    match app-id="^org\\.kde\\.kcolorchooser$"
    match app-id="^gcolor3$"
    match app-id="^com\\.github\\.finefindus\\.eyedropper$"
    match app-id="^org\\.gnome\\.clocks$"
    exclude app-id="^brave"
    exclude app-id="^chromium"
    exclude app-id="^firefox"
    exclude app-id="^zen"
    exclude app-id="^com\\.mitchellh\\.ghostty$"
    exclude app-id="^kitty$"
    exclude app-id="^foot"
    exclude app-id="^REAPER$"
    open-floating true
}
